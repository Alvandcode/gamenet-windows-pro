{
  "name": "gamenet-manager-alvand",
  "version": "1.8.0",
  "description": "Gamenet Manager Pro - Desktop by Alvandcode",
  "author": "Alvand",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.alvand.gamenet.manager",
    "productName": "Gamenet Manager Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gamenet Manager Pro",
      "uninstallDisplayName": "Gamenet Manager Pro"
    },
    "portable": {
      "artifactName": "GamenetManager-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}







